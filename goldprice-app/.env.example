## Copy this file to .env and edit. Keep .env out of version control and set its
## permissions to 600 in production.

APP_NAME="Gold Price Today Sri Lanka"
APP_URL=http://127.0.0.1:8000
APP_ENV=local
APP_DEBUG=true
APP_KEY=

FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false

# --- Database -----------------------------------------------------------
# DB_CONNECTION=mysql or sqlite
DB_CONNECTION=sqlite
DB_SQLITE_PATH=storage/database.sqlite

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=goldprice
DB_USERNAME=root
DB_PASSWORD=

# --- Gold spot price (XAU/USD) ------------------------------------------
GOLD_PRICE_PRIMARY_PROVIDER=gold_api_com

# secondary: metalpriceapi | goldapi_io | goldprice_dev | none
GOLD_PRICE_SECONDARY_PROVIDER=none
GOLD_PRICE_SECONDARY_API_KEY=
GOLDAPI_IO_KEY=
# https://goldprice.dev - free tier works without a key; a key raises the rate limit
GOLDPRICE_DEV_API_KEY=
GOLD_SECONDARY_MIN_INTERVAL=45

# --- USD/LKR exchange rate -----------------------------------------------
# primary: open_exchange_rates | exchangerate_api_open | exchangerate_api | metalpriceapi
FX_PRIMARY_PROVIDER=open_exchange_rates
EXCHANGE_RATE_API_KEY=

# secondary: exchangerate_api_open | exchangerate_api | metalpriceapi
FX_SECONDARY_PROVIDER=exchangerate_api_open
EXCHANGERATE_API_KEY=

FX_PRIMARY_MIN_INTERVAL=60
FX_SECONDARY_MIN_INTERVAL=360

# --- Verification ----------------------------------------------------------
REQUIRE_SECONDARY_SOURCE=false
MAX_SOURCE_DIFFERENCE_PERCENT=1
MAX_GOLD_MOVE_PERCENT=5
MAX_FX_MOVE_PERCENT=3
MAX_GOLD_READING_AGE_MINUTES=90
MAX_FX_READING_AGE_MINUTES=180

# --- Scheduler ---------------------------------------------------------
PRICE_UPDATE_INTERVAL=15
MARKET_CLOSED_INTERVAL=180
RETRY_AFTER_MINUTES=5
NEWS_UPDATE_INTERVAL=60
GOLD_MARKET_HOLIDAYS=

# --- Alerts / mail -------------------------------------------------------
ADMIN_EMAIL=you@example.lk
MAIL_FROM=noreply@example.lk
NOTIFY_COOLDOWN_MINUTES=60
ALERTS_ENABLED=false

# --- Misc ----------------------------------------------------------------
LOG_RETENTION_DAYS=30
CRON_TOKEN=
SESSION_NAME=goldprice_session
